# path        — id модели в AnyModel (как в GET /v1/models, с префиксом провайдера)
# name        — что видит пользователь
# multiplier  — коэффициент базовых токенов (0 = бесплатно)
# plans       — тарифы, которым модель доступна
# vision      — принимает изображения
# reasoning   — показывать статус «рассуждает»
# web_search  — разрешить встроенный веб-поиск провайдера
# default     — модель по умолчанию для тарифа

models:
