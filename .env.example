# ── Telegram ───────────────────────────────────────────────
BOT_TOKEN=change_me
BOT_USERNAME=blrd_ai_bot
WEBAPP_URL=https://ai.example.com
ADMIN_IDS=1234567890

# ── AnyModel ───────────────────────────────────────────────
ANYMODEL_API_KEY=sk-...
ANYMODEL_BASE_URL=https://anymodel.org/v1

# ── Platega ────────────────────────────────────────────────
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_PAYMENT_METHOD=2
# публичный URL для колбэка: {WEBAPP_URL}/api/payments/platega/callback
PLATEGA_CALLBACK_SECRET_CHECK=true

# ── Приложение ─────────────────────────────────────────────
SECRET_KEY=change-me-to-64-random-chars
DATABASE_URL=sqlite+aiosqlite:///./data/blrd.db
# прод: postgresql+asyncpg://blrd:blrd@db:5432/blrd
DATA_DIR=./data
PUBLIC_HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ── Админка ────────────────────────────────────────────────
ADMIN_PASSWORD=change_me

# ── Экономика ──────────────────────────────────────────────
TOKENS_PER_ENERGY=3000
WEB_SEARCH_BASE_COST=40000
MAX_UPLOAD_MB=20
